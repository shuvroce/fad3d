<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FAD - Facade Analysis & Design v2.0</title>
    <link rel="icon" href="/static/assets/fav.png" type="image/png">
    <link rel="stylesheet" href="/static/css/app.css">
    <script type="importmap">
    {
        "imports": {
            "three": "/static/js/three/three.module.js",
            "three/addons/": "/static/js/three/examples/jsm/"
        }
    }
    </script>
</head>

<body>
    <header class="topbar" aria-label="Workspace controls">
        <div class="topbar__left">
            <div class="topbar__logo-badge" aria-label="Facade Report" role="img"></div>
            <div class="topbar__header-btn">
                <!-- <button class="topbar__icon-btn" type="button" data-title="Dashboard" aria-label="Dashboard"
                    id="dashboard-btn">
                    <svg class="topbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="4.5" y="4.5" width="6" height="6" rx="1.2"></rect>
                        <rect x="13.5" y="4.5" width="6" height="4" rx="1.2"></rect>
                        <rect x="13.5" y="11.5" width="6" height="9" rx="1.2"></rect>
                        <rect x="4.5" y="13.5" width="6" height="6" rx="1.2"></rect>
                    </svg>
                </button> -->
                <button class="topbar__icon-btn" type="button" data-title="Open" aria-label="Open" id="load-btn">
                    <svg class="topbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 19h16a1 1 0 0 0 1-1v-7H9l-2-3H3v10a1 1 0 0 0 1 1Z"></path>
                        <path d="M4 8V6a1 1 0 0 1 1-1h5.5l2 3H22"></path>
                    </svg>
                </button>
                <button class="topbar__icon-btn" type="button" data-title="Save" aria-label="Save" id="download-btn">
                    <svg class="topbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 5h12l2 2v12a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1Z"></path>
                        <path d="M15 5v6H7V5"></path>
                        <path d="M12 17.5v.01"></path>
                    </svg>
                </button>
            </div>

            <input type="file" id="yaml-file-input" accept=".fad,application/json" hidden />
            <div class="topbar__projct-name" id="header-project-name">
                Project Name
            </div>
            <div id="topbar__status-notification" class="topbar__status-notification"></div>
        </div>

        <div class="topbar__right">
            <div class="topbar__license-container">
                <div>License status:</div>
                <div class="topbar__license" aria-label="License status">
                    <span class="topbar__license-dot topbar__license-active" aria-hidden="true"></span>
                    <span class="topabr__license-text">Active</span>
                </div>
            </div>

            <div class="topbar__right-header-btn">
                <div class="topbar__support-wrap" id="support-wrap">
                    <button class="topbar__header-icon-btn" type="button" aria-label="Support" id="support-btn"
                        aria-haspopup="true" aria-expanded="false">
                        <svg class="topbar__icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 12a8 8 0 0 1 16 0"></path>
                            <rect x="3" y="11" width="4" height="7" rx="2"></rect>
                            <rect x="17" y="11" width="4" height="7" rx="2"></rect>
                            <path d="M7 18a3 3 0 0 0 3 3h2"></path>
                            <rect x="12" y="20" width="4" height="2.5" rx="1.25"></rect>
                        </svg>
                        <p>Support</p>
                    </button>
                    <div class="topbar__support-submenu" id="support-submenu" hidden>
                        <button class="topbar__support-submenu-btn" id="feedback-modal-btn">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                            </svg>
                            Send Feedback
                        </button>
                        <button class="topbar__support-submenu-btn" id="contact-modal-btn">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.11 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16v.92z">
                                </path>
                            </svg>
                            Contact Us
                        </button>
                    </div>
                </div>

                <button class="topbar__header-icon-btn" type="button" aria-label="Help" id="help-btn">
                    <svg class="topbar__icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M9.5 9a2.5 2.5 0 0 1 4.5 1.3c0 1.7-2 2.1-2 3.2"></path>
                        <circle cx="12" cy="16.5" r="0.9"></circle>
                    </svg>
                    <p>Help</p>
                </button>

                <button class="topbar__header-icon-btn" type="button" aria-label="Learn" id="">
                    <svg class="topbar__icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v14H6.5A2.5 2.5 0 0 0 4 20.5Z"></path>
                        <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H18"></path>
                        <path d="M8 8.5h8"></path>
                        <path d="M8 12h6"></path>
                    </svg>
                    <p>Learn</p>
                </button>

                <button class="topbar__header-icon-btn" type="button" aria-label="Setting" id="settings-btn">
                    <svg class="topbar__icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path
                            d="M19 12a7 7 0 0 0-.09-1.11l2.03-1.58-2-3.46-2.44.86a7.1 7.1 0 0 0-1.92-1.11L14.2 3h-4.4l-.38 2.6a7.1 7.1 0 0 0-1.92 1.11l-2.44-.86-2 3.46 2.03 1.58A7 7 0 0 0 5 12c0 .38.03.75.09 1.11l-2.03 1.58 2 3.46 2.44-.86c.58.47 1.22.84 1.92 1.11l.38 2.6h4.4l.38-2.6c.7-.27 1.34-.64 1.92-1.11l2.44.86 2-3.46-2.03-1.58c.06-.36.09-.73.09-1.11Z">
                        </path>
                    </svg>
                    <p>Setting</p>
                </button>
            </div>

            <div class="topbar__report-btn-container" id="report-dropdown-container">
                <button class="topbar__btn-report" id="report-btn" type="button"
                    aria-label="Generate Report">Report</button>
                <button class="topbar__btn-report-sub" id="report-dropdown-toggle" type="button"
                    aria-label="Report options" aria-expanded="false" aria-haspopup="true">
                    <svg class="topbar__icon-svg report__chevron" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 9l6 6 6-6"></path>
                    </svg>
                </button>
                <ul class="report__dropdown" id="report-dropdown" role="menu">
                    <li role="none">
                        <button class="report__dropdown-item" role="menuitem" type="button">Summary Report</button>
                    </li>
                </ul>
            </div>
            <!-- <div class="topbar__user-meta" aria-label="Signed-in user">
                        <div class="topbar__user-name">Md. Akram Hossain</div>
                        <div class="topbar__user-role">Structural Engineer</div>
                    </div> -->
            <div class="topbar__user-avatar" aria-hidden="true">
                <img src="/static/assets/dp.jpg" alt="User avatar" />
            </div>

            <div class="">
                <button class="theme__toggle" id="theme__toggle" aria-label="Toggle dark mode" data-title="Theme">
                    <svg id="theme-icon-sun" class="theme__icon sun hidden" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="4"></circle>
                        <line x1="12" y1="2" x2="12" y2="5"></line>
                        <line x1="12" y1="19" x2="12" y2="22"></line>
                        <line x1="4.22" y1="4.22" x2="6.34" y2="6.34"></line>
                        <line x1="17.66" y1="17.66" x2="19.78" y2="19.78"></line>
                        <line x1="2" y1="12" x2="5" y2="12"></line>
                        <line x1="19" y1="12" x2="22" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="6.34" y2="17.66"></line>
                        <line x1="17.66" y1="6.34" x2="19.78" y2="4.22"></line>
                    </svg>
                    <svg id="theme-icon-moon" class="theme__icon moon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <section class="floating__bar">
        <div class="floating__bar-left">
            <div class="floating__bar-left-button">
                <button class="floating__bar-btn">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2" />
                    </svg>
                    Wind
                </button>
                <button class="floating__bar-btn active">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="1" />
                        <path d="M9 22V12h6v10" />
                        <path d="M3 9h18" />
                    </svg>
                    Facade
                </button>
            </div>

            <div class="floating__bar-left-button">
                <button class="floating__bar-btn" id="general-modal-btn">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <line x1="4" y1="21" x2="4" y2="14" />
                        <line x1="4" y1="10" x2="4" y2="3" />
                        <line x1="12" y1="21" x2="12" y2="12" />
                        <line x1="12" y1="8" x2="12" y2="3" />
                        <line x1="20" y1="21" x2="20" y2="16" />
                        <line x1="20" y1="12" x2="20" y2="3" />
                        <line x1="1" y1="14" x2="7" y2="14" />
                        <line x1="9" y1="8" x2="15" y2="8" />
                        <line x1="17" y1="16" x2="23" y2="16" />
                    </svg>
                    General
                </button>
                <div class="floating__bar-define-wrap" id="define-wrap">
                    <button class="floating__bar-btn" id="define-modal-btn">
                        <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                        </svg>
                        Define
                        <svg class="floating__bar-chevron" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 9l6 6 6-6"></path>
                        </svg>
                    </button>
                    <div class="floating__bar-submenu" id="define-submenu" hidden>
                        <button class="floating__bar-submenu-btn" id="material-modal-btn">
                            <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                                <polyline points="2 17 12 22 22 17" />
                                <polyline points="2 12 12 17 22 12" />
                            </svg>
                            Material
                        </button>
                        <div class="floating__bar-submenu-item floating__bar-submenu-item--nested"
                            id="section-submenu-wrap">
                            <button class="floating__bar-submenu-btn floating__bar-submenu-btn--nested"
                                id="section-submenu-trigger">
                                <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="2" y="2" width="4" height="20" rx="1" />
                                    <rect x="10" y="2" width="4" height="20" rx="1" />
                                    <rect x="18" y="2" width="4" height="20" rx="1" />
                                </svg>
                                Section
                                <svg class="floating__bar-chevron floating__bar-chevron--right" viewBox="0 0 24 24"
                                    aria-hidden="true">
                                    <polyline points="9 18 15 12 9 6"></polyline>
                                </svg>
                            </button>
                            <div class="floating__bar-submenu floating__bar-submenu--nested" id="section-submenu"
                                hidden>
                                <button class="floating__bar-submenu-btn" id="section-alum-btn">
                                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="2" y="3" width="20" height="18" rx="1" />
                                        <line x1="2" y1="9" x2="22" y2="9" />
                                        <line x1="12" y1="9" x2="12" y2="21" />
                                    </svg>
                                    Aluminum
                                </button>
                                <button class="floating__bar-submenu-btn" id="section-steel-btn">
                                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                                        <line x1="3" y1="5" x2="21" y2="5" />
                                        <line x1="3" y1="19" x2="21" y2="19" />
                                        <line x1="12" y1="5" x2="12" y2="19" />
                                    </svg>
                                    Steel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="floating__bar-right">
            <div class="floating__bar-right-view">
                <button class="floating__bar-btn floating__bar-btn--filter" id="filter-btn">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path
                            d="M19 12a7 7 0 0 0-.09-1.11l2.03-1.58-2-3.46-2.44.86a7.1 7.1 0 0 0-1.92-1.11L14.2 3h-4.4l-.38 2.6a7.1 7.1 0 0 0-1.92 1.11l-2.44-.86-2 3.46 2.03 1.58A7 7 0 0 0 5 12c0 .38.03.75.09 1.11l-2.03 1.58 2 3.46 2.44-.86c.58.47 1.22.84 1.92 1.11l.38 2.6h4.4l.38-2.6c.7-.27 1.34-.64 1.92-1.11l2.44.86 2-3.46-2.03-1.58c.06-.36.09-.73.09-1.11Z">
                        </path>
                    </svg>
                </button>
            </div>
            <div class="floating__bar-right-view">
                <button class="floating__bar-btn active">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
                        <line x1="12" y1="22.08" x2="12" y2="12" />
                    </svg>
                    Model
                </button>
                <button class="floating__bar-btn">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                        <line x1="2" y1="20" x2="22" y2="20" />
                    </svg>
                    DC Ratio
                </button>
                <button class="floating__bar-btn">
                    <svg class="floating__bar-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <line x1="3" y1="8" x2="21" y2="8" />
                        <path d="M3 8 Q12 20 21 8" />
                        <line x1="3" y1="6" x2="3" y2="10" />
                        <line x1="21" y1="6" x2="21" y2="10" />
                    </svg>
                    Deflection
                </button>
            </div>
            <div class="floating__bar-right-view">
                <button class="floating__bar-btn floating__bar-btn--figures" id="figures-btn">
                    <span class="figures__indicator" id="figures-indicator"></span>
                    Figures
                    <svg class="floating__bar-chevron figures__chevron" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 9l6 6 6-6"></path>
                    </svg>
                </button>
            </div>
            <div class="figure__panel" id="figure-panel">
                <!-- figure status dynamically load here -->
            </div>
        </div>
    </section>

    <section class="left__panel">
        <div class="catbar" aria-label="Categories">
            <div class="catbar__scroll">
                <!-- Category buttons will be dynamically created here -->
            </div>
            <button class="catbar__btn add" id="cat-add" type="button" data-title="Add Category"
                aria-label="Add Category">
                <svg class="catbar__icon" viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
            </button>
        </div>

        <div class="input__slide-unit">
            <div class="input__box" id="input-container">
                <!-- Categories will be dynamically created here -->
            </div>
            <button class="left__panel-toggle-left" type="button" aria-label="Collapse left panel"
                data-title="Collapse left panel">
                <svg class="panel__toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.5 6.5L9 12l5.5 5.5"></path>
                </svg>
            </button>
        </div>
    </section>

    <section class="viewport__container">
        <div id="viewport-3d"></div>
    </section>

    <section class="right__panel">
        <button class="right__panel-toggle-right" type="button" aria-label="Collapse right panel"
            data-title="Collapse right panel">
            <svg class="panel__toggle-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9.5 6.5L15 12l-5.5 5.5"></path>
            </svg>
        </button>
        <div class="result__box">
            <h2 class="result__heading">Design Summary</h2>

            <!-- Tab Navigation -->
            <div class="result__tabs">
                <button class="result__tab-btn" data-result-tab="wind">
                    Wind
                </button>
                <button class="result__tab-btn active" data-result-tab="facade">
                    Facade
                </button>
            </div>

            <!-- Wind Tab Content (cards injected from result-wind-tab-template) -->
            <div class="result__tab-content hidden" data-result-tab="wind"></div>

            <!-- Facade Tab Content (cards injected from result-facade-tab-template) -->
            <div class="result__tab-content" data-result-tab="facade"></div>
        </div>
    </section>

    <div id="nav-cube-container">
        <div id="nav-cube-axis"></div>
    </div>

    <!-- Glass Chart Modal -->
<div id="glass-chart-modal" class="modal">
    <div class="modal__dialog">
        <div class="modal__header">
            <h2 class="modal__title">Glass Reference Chart</h2>
            <button type="button" class="modal__close" aria-label="Close modal">
                <svg viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="modal__content">
            <img id="glass-chart-image" src="" alt="Glass chart" style="display: none" />
            <div id="glass-chart-loading" style="text-align: center; color: var(--text-secondary)">
                <p>Loading chart...</p>
            </div>
        </div>
    </div>
</div>

<!-- Category Icon Selector Modal -->
<div id="category-icon-modal" class="modal">
    <div class="modal__dialog modal__dialog-small">
        <div class="modal__header">
            <h2 class="modal__title">Select Category Icon</h2>
            <button type="button" class="modal__close" id="close-icon-selector" aria-label="Close modal">
                <svg viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="modal__content">
            <div class="icon-grid" id="icon-grid">
                <!-- Icons will be populated here -->
            </div>
            <div class="modal__footer">
                <button type="button" class="modal__btn modal__btn-secondary" id="remove-category-icon">
                    Remove Icon
                </button>
            </div>
        </div>
    </div>
</div>

<!-- General Info Modal -->
<div id="general-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="general-modal-title">
    <div class="modal__dialog modal__dialog-large">
        <div class="modal__header">
            <h2 class="modal__title" id="general-modal-title">
                <svg class="modal__title-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="4" y1="21" x2="4" y2="14" />
                    <line x1="4" y1="10" x2="4" y2="3" />
                    <line x1="12" y1="21" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12" y2="3" />
                    <line x1="20" y1="21" x2="20" y2="16" />
                    <line x1="20" y1="12" x2="20" y2="3" />
                    <line x1="1" y1="14" x2="7" y2="14" />
                    <line x1="9" y1="8" x2="15" y2="8" />
                    <line x1="17" y1="16" x2="23" y2="16" />
                </svg>
                General
            </h2>
            <button type="button" class="modal__close" id="close-general-modal" aria-label="Close modal">
                <svg viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
        <div class="modal__content">
            <p class="modal__section-heading">Project Info</p>
            <div class="modal__form-grid">
                <div class="input__field">
                    <label for="gen-project-number">Ref. No.</label>
                    <input type="text" id="gen-project-number" placeholder="e.g. RFA-001/REV-02/AEL/NAVA/2026">
                </div>
                <div class="input__field">
                    <label for="gen-project-name">Project Name</label>
                    <input type="text" id="gen-project-name" placeholder="Enter project name">
                </div>
                <div class="input__field">
                    <label for="gen-project-location">Project Location</label>
                    <input type="text" id="gen-project-location" placeholder="e.g. Dhaka">
                </div>
                <div class="input__field">
                    <label for="gen-client">Project Client</label>
                    <input type="text" id="gen-client" placeholder="Enter client name">
                </div>
                <div class="input__field">
                    <label for="gen-rev">Revision No.</label>
                    <input type="text" id="gen-rev" placeholder="0">
                </div>
                <div class="input__field">
